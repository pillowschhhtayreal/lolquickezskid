function GetDoubleTapCount(arg)
	local doubleTap = getCider().Modifications["Double Tap"]
	if not doubleTap.Enabled then
		return 1
	end

	if doubleTap.Mode ~= "Always" and not State.DoubleTapActive then
		return 1
	end
	local weaponConfigs = doubleTap["Weapon Configs"]

	if weaponConfigs and weaponConfigs.Enabled then
		local weaponConfig = weaponConfigs[fn3(arg)]
		if weaponConfig and not weaponConfig.Enabled then
			return 1
		end
	end

	return 2
end

