function CleanScripts(arg)
	if not arg then
		return
	end

	for _, localScript in next, arg:GetDescendants() do
		if localScript:IsA("LocalScript") then
			localScript:Destroy()
		end
	end

	TrackConn(arg.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("LocalScript") then
			descendant:Destroy()
		end
	end))
end

