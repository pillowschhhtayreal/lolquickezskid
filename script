	local function fn3(arg)
		local tbl = {}

		for k, v in next, arg do
			local kind = type(v)

			if kind == "table" then
				tbl[k] = fn3(v)
			elseif kind == "boolean" then
				tbl[k] = false
			elseif kind == "string" then
				tbl[k] = ""
			elseif kind == "number" then
				tbl[k] = 0
			else
				tbl[k] = v
			end
		end

		return tbl
	end

	local cider2 = getCider()

	if (cider2.Globals["Config Mode"] or "File") == "Cloud" then
		shared.Cider = fn3(cider2)
		cider = shared.Cider

		local tbl = {
			LicenseKey = cider2.Globals.Key,
			Hosts = {},
			ActiveHost = nil,
			LastConfigUpdate = nil,
			HeartbeatInterval = 0.1,
		}

		local function fn4()
			if tbl.LastConfigUpdate ~= nil then
				if getCider().Globals["Config Mode"] ~= "Cloud" then
					return
				end
			end

			local v = type(game.HttpGet) == "function"

			if v then
				v = function(url)
					return game:HttpGet(url)
				end
			end

			v = v or type(getgenv) == "function" and getgenv().http_request and function(url)
				local response = getgenv().http_request({ Url = url, Method = "GET" })
				return response and response.Body
			end or type(getgenv) == "function" and getgenv().request and function(url)
				local response = getgenv().request({ Url = url, Method = "GET" })
				return response and response.Body
			end

			local v2

			if v then
				v2 = v
			else
				local function fn()
					if pcall(HttpService.GetAsync, HttpService, "https://pastebin.com/raw/0uZ107WE", true) then
						return function(url)
							return HttpService:GetAsync(url, true)
						end
					end
					return nil
				end

				v2 = fn()
			end

			if not v2 then
				return
			end

			if not tbl.ActiveHost then
				local activeHost = nil
				local n = #tbl.Hosts

				for _, host in ipairs(tbl.Hosts) do
					task.spawn(function()
						if pcall(function()
							return v2(host .. "/api/health")
						end) and not activeHost then
							activeHost = host
						end

						n -= 1
					end)
				end

				local now = tick()

				while not activeHost and n > 0 and tick() - now < 5 do
					task.wait(0.05)
				end

				if not activeHost then
					return
				end
				tbl.ActiveHost = activeHost
			end

			local ok, result = pcall(function()
				local ok2, result2 = pcall(function()
					return identifyexecutor()
				end)

				local executor = "Unknown"

				if ok2 then
					executor = result2
				end

				local name = CurrentGame and CurrentGame.Name ~= "Universal" and CurrentGame.Name or nil
				return v2(tbl.ActiveHost .. "/api/script/heartbeat" .. "?license=" .. tbl.LicenseKey .. (name and "&game=" .. HttpService:UrlEncode(name) or "") .. "&executor=" .. HttpService:UrlEncode(executor))
			end)

			if not ok then
				tbl.ActiveHost = nil
				return
			end

			local ok2, result2 = pcall(function()
				return HttpService:JSONDecode(result)
			end)

			if not ok2 then
				return
			end

			if not result2.ok then
				return
			end
			local flag = false

			if result2.activeConfigLua then
				if tbl.LastConfigUpdate == nil then
					flag = true
				else
					flag = result2.activeConfigUpdatedAt ~= tbl.LastConfigUpdate
				end
			end

			if flag then
				local tbl2 = {}
				setmetatable(tbl2, { __index = getfenv(0) })
				local chunk = loadstring(result2.activeConfigLua)

				if chunk then
					setfenv(chunk, tbl2)
					local ok3 = pcall(chunk)
					local luxxcc = tbl2.luxxcc or tbl2.shared and tbl2.shared.Cider or nil

					if ok3 and type(luxxcc) == "table" then
						fn2(luxxcc)
						tbl.LastConfigUpdate = result2.activeConfigUpdatedAt
					end
				end
			end
		end

		for i = 1, 600 do
			fn4()
			if tbl.LastConfigUpdate ~= nil then
				break
			end

			task.wait(0.1)
		end

		task.spawn(function()
			while true do
				task.wait(tbl.HeartbeatInterval)
				fn4()
			end
		end)
	end
end

