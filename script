function RunTriggerbot()
	local triggerbot = getCider().Triggerbot
	if not triggerbot.Enabled then
		return
	end

	if not State.TriggerState then
		return
	end
	local triggerbotTarget = State.Targets.Triggerbot
	local character = triggerbotTarget and triggerbotTarget.Character
	if not character then
		return
	end
	local character2 = localPlayer.Character
	if not character2 then
		return
	end
	local tool = character2:FindFirstChildOfClass("Tool")
	if not tool or not tool:FindFirstChild("Ammo") or tool.Name == "[Knife]" then
		return
	end

	if not State.CanTriggerbotShoot then
		return
	end
	local humanoid = character2:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local bodyEffects = character2:FindFirstChild("BodyEffects")
	if not bodyEffects then
		return
	end

	if bodyEffects:FindFirstChild("K.O") and bodyEffects["K.O"].Value then
		return
	end

	if bodyEffects:FindFirstChild("Reload") and bodyEffects.Reload.Value then
		return
	end

	if bodyEffects:FindFirstChild("Dead") and bodyEffects.Dead.Value then
		return
	end

	if not PassesConditions(triggerbotTarget, "Triggerbot") then
		return
	end
	local humanoidRootPart = character2:FindFirstChild("HumanoidRootPart")
	local humanoidRootPart2 = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart or not humanoidRootPart2 then
		return
	end

	if (humanoidRootPart.Position - humanoidRootPart2.Position).Magnitude > (triggerbot["Max Range"] or MathHuge) then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	if not handle then
		return
	end
	local name = tool.Name
	local range = tool:FindFirstChild("Range")
	local n = range and range.Value or 200

	if triggerbot["Limit To Weapon Range"] then
		if ((GetMuzzlePosition(tool) or humanoidRootPart.Position) - humanoidRootPart2.Position).Magnitude > n then
			return
		end
	end

	local currentCamera = Workspace.CurrentCamera
	local y = currentCamera.ViewportSize.Y
	local fieldOfView = currentCamera.FieldOfView
	local position = humanoidRootPart2.Position
	local prediction = triggerbot.Prediction

	if prediction and prediction.Enabled == true then
		local deltaVelocity = GetDeltaVelocity(humanoidRootPart2)
		position += Vector3New(deltaVelocity.X * (prediction.X or 0.13), deltaVelocity.Y * (prediction.Y or 0.13), deltaVelocity.Z * (prediction.Z or 0.13))
	end

	local offscreenTargeting = triggerbot["Offscreen Targeting"]
	local enabled = offscreenTargeting and offscreenTargeting.Enabled
	local screenPos, onScreen = currentCamera:WorldToViewportPoint(position)
	if not onScreen and not enabled then
		return
	end

	if not fn8(position, "Triggerbot") then
		return
	end
	local triggerMode = triggerbot["Trigger Mode"] or "FOV"
	local triggerbotFov = getCider().Main.FOV.Triggerbot
	local flag

	if string.lower(tostring(triggerbotFov.Options or "2D")) == "3d" then
		flag = true
	elseif enabled then
		flag = true
	elseif triggerMode == "Player" then
		local target = localPlayer:GetMouse().Target
		flag = target and target:IsDescendantOf(character)
	else
		local mouseLocation = UserInputService:GetMouseLocation()
		local delta = Vector2New(screenPos.X, screenPos.Y) - mouseLocation
		local z = screenPos.Z
		if z <= 1 then
			return
		end
		local n2 = humanoidRootPart2.Size.Y * y / (z * 2) * 80 / fieldOfView
		local n3 = (triggerbotFov.Width and (triggerbotFov.Width[1] or 9e9) or 9e9) * n2
		local n4 = (triggerbotFov.Height and (triggerbotFov.Height[1] or 9e9) or 9e9) * n2
		flag = not triggerbotFov.Visualize.Enabled or MathAbs(delta.X) <= n3 / 2 and MathAbs(delta.Y) <= n4 / 2
	end

	if flag then
		local muzzlePosition = GetMuzzlePosition(tool) or humanoidRootPart.Position

		if not CachedMainEvent then
			CachedMainEvent = ReplicatedStorage:FindFirstChild("MainEvent")
		end

		if not CachedMainEvent then
			return
		end
		local delay = triggerbot.Delay or 0
		local v = fn4(tool)
		local n2 = MathMax(delay, v)
		TriggerShot(n2, tool, handle, name, muzzlePosition, position, n)
	end
end

