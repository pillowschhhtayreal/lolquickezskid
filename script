function EmulateGunFire(child)
	local character = localPlayer.Character
	if not character then
		return
	end

	if _G.GUN_COMBAT_TOGGLE then
		return
	end

	if not CanShoot(character) then
		return
	end
	local handle = child:FindFirstChild("Handle")
	if not handle then
		return
	end
	local ammo = child:FindFirstChild("Ammo")

	if not ammo or ammo.Value <= 0 then
		local noAmmo = handle:FindFirstChild("NoAmmo")

		if noAmmo then
			noAmmo:Play()
		end

		return
	end

	local range = child:FindFirstChild("Range")
	local n = range and range.Value or 200
	local remoteEvent = child:FindFirstChild("RemoteEvent") or { FireServer = function() end }
	local muzzlePosition = GetMuzzlePosition(child)
	if not muzzlePosition then
		return
	end
	local isShotgunWeapon = ShotgunWeapons[child.Name] or false
	ShootRayParams.FilterDescendantsInstances = BuildFilter(ShootFilter, character)
	remoteEvent:FireServer("Shoot")

	for i = 1, GetDoubleTapCount(child.Name) do
		if isShotgunWeapon then
			local serverTimeNow = Workspace:GetServerTimeNow()
			local spreadModifications = getCider().Modifications["Spread Modifications"]
			local n2 = 1

			if spreadModifications.Enabled then
				n2 = spreadModifications.Value or 1
				local randomizer = spreadModifications.Randomizer

				if randomizer and randomizer.Enabled then
					local min = randomizer.Min or 1
					n2 *= min + ((randomizer.Max or 1) - min) * MathRandom()
				end
			end

			for i2 = 1, 5 do
				local n3 = (MathRandom() > 0.5 and MathRandom() * 0.05 or -MathRandom() * 0.05) * n2
				local n4 = (MathRandom() > 0.5 and MathRandom() * 0.1 or -MathRandom() * 0.1) * n2
				local n5 = MathRandom() > 0.5 and MathRandom() * 0.05 or -MathRandom() * 0.05
				local vector = Vector3New(n3, n4, n5 * n2)
				local v = (fn9() - muzzlePosition).Unit + vector
				local v2 = muzzlePosition + v * n
				local position = nil
				local instance = nil
				local normal = nil

				if i == 1 then
					position, instance, normal = ShowPellet(character, handle, muzzlePosition, v2, n)
				end

				if not position then
					local v3 = v * n
					local hit = Workspace:Raycast(muzzlePosition, v3, ShootRayParams)
					position = hit and hit.Position or muzzlePosition + v3
					instance = hit and hit.Instance or nil
					normal = hit and hit.Normal or Vector3New(0, 1, 0)
				end

				local v3, v4, v5 = ApplyDamageModifierHit(child.Name, position, instance, normal)
				ReplicatedStorage.MainEvent:FireServer("ShootGun", handle, muzzlePosition, v3, v4, v5, serverTimeNow)
			end
		else
			local v = fn9()
			local vector = muzzlePosition + (v - muzzlePosition).Unit * n
			local v2 = nil
			local v3 = nil
			local v4 = nil

			if i == 1 then
				v2, v3, v4 = ShowPellet(character, handle, muzzlePosition, vector, n)
			end

			if not v2 then
				local v5 = (v - muzzlePosition).Unit * n
				local hit = Workspace:Raycast(muzzlePosition, v5, ShootRayParams)
				local position = hit and hit.Position or muzzlePosition + v5
				local instance = hit and hit.Instance or nil
				local normal = hit and hit.Normal

				if normal then
					v2 = position
					v3 = instance
					v4 = normal
				else
					v2 = position
					v3 = instance
					v4 = Vector3New(0, 1, 0)
				end
			end

			local v5, v6, v7 = ApplyDamageModifierHit(child.Name, v2, v3, v4)
			ReplicatedStorage.MainEvent:FireServer("ShootGun", handle, muzzlePosition, v5, v6, v7)
		end
	end

	remoteEvent:FireServer()
end

