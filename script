function BuildFilter(arg, arg2)
	local n = 0

	if arg2 then
		arg[1] = arg2
		n = 1
	end

	if CachedIgnored then
		n += 1
		arg[n] = CachedIgnored
	end

	if CachedBush then
		n += 1
		arg[n] = CachedBush
	end

	for i = n + 1, #arg do
		arg[i] = nil
	end

	return arg
end

