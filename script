function GetHealthBarArmor(player)
	local character = player and player.Character
	local bodyEffects = character and character:FindFirstChild("BodyEffects")
	local armor = bodyEffects and (bodyEffects:FindFirstChild("Armor") or bodyEffects:FindFirstChild("Armour") or bodyEffects:FindFirstChild("Defense"))
	if armor and tonumber(armor.Value) then
