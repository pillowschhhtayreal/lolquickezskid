function normalizeForLookup(arg)
	local v = string.lower(tostring(arg or ""))
	local v2 = string.gsub(v, "^@", "")
	local v3 = string.gsub(v2, "%s+", "")
	return (string.gsub(v3, "_+", ""))
end

function findUserIdInServerByNameOrDisplay(arg)
	local str = tostring(arg or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local v = string.lower(str)
	local v2 = normalizeForLookup(str)
	if v2 == "" then
		return nil
	end
	local userIds = {}
	local userId = nil
	local count = 0
	local userId2 = nil

	for _, player in ipairs(Players2:GetPlayers()) do
		local lowerName = string.lower(player.Name)
		local lowerDisplayName = string.lower(player.DisplayName)
		local v3 = normalizeForLookup(player.Name)
		local v4 = normalizeForLookup(player.DisplayName)
		if lowerName == v or v3 == v2 then
			userId2 = player.UserId
			break
		end

		if lowerDisplayName == v or v4 == v2 then
			userId = player.UserId
			count += 1
		end

		local flag = v ~= "" and string.sub(lowerName, 1, #v) == v or string.sub(v3, 1, #v2) == v2
		local flag2 = v ~= "" and string.sub(lowerDisplayName, 1, #v) == v or string.sub(v4, 1, #v2) == v2

		if flag or flag2 then
			userIds[#userIds + 1] = player.UserId
		end
	end

	if userId2 then
		return userId2
	end

	if count == 1 then
		return userId
	end

	if #userIds > 0 then
		return userIds[1]
	end

	if userId then
		return userId
	end
	return nil
end

