	local function fn3(tool, arg)
		if not tool then
			return
		end
		local skinChanger = getCider().Utilities["Skin Changer"]
		if not skinChanger or not skinChanger.Enabled then
			return
		end
		local skin = skinChanger.Skins and skinChanger.Skins[tool.Name]
		if not arg and skinByTool[tool] == skin then
			return
		end
		skinByTool[tool] = skin
		local cachedSkinAssets = CachedSkinAssets
		if not cachedSkinAssets then
			return
		end
		local v

		if tool.Name == "[Knife]" then
			v = cachedSkinAssets:FindFirstChild("KnifeSkins") and cachedSkinAssets.KnifeSkins:FindFirstChild(skin)
		else
			v = cachedSkinAssets:FindFirstChild("GunSkins") and cachedSkinAssets.GunSkins:FindFirstChild(skin)
		end

		local default = tool:FindFirstChild("Default")
		if not default then
			return
		end
		local mesh = default:FindFirstChild("Mesh")

		if mesh then
			mesh:Destroy()
		end

		if v then
			local basePart = v:FindFirstChildWhichIsA("BasePart") or v:FindFirstChild("Mesh")

			if basePart then
				local clone = basePart:Clone()
				clone.Parent = default
				clone.Name = "Mesh"
			end
		end

		local handle = tool:FindFirstChild("Handle")

		if handle then
			handle:SetAttribute("SkinName", skin or "")
		end
	end

	fn = function()
		local character = localPlayer.Character

		if character then
			for _, tool in next, character:GetChildren() do
				if tool:IsA("Tool") then
