function PassesConditions(player, arg)
	local checks = getCider().Main.Checks
	local check = arg and checks[arg] or {}
	local character = player and player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if check.Knocked then
		if not humanoid or humanoid.Health <= 0 or humanoid:GetState() == EnumDead then
			return false
		end

		if CurrentGame.Knocked(player) then
			return false
		end
	end

	if check.Grabbed then
		if CurrentGame.Grabbed(player) then
			return false
		end
	end

	if check.Vehicle then
		if humanoid and humanoid.Sit then
			return false
		end
	end

	if check.Visible then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart and not IsVisible(humanoidRootPart.Position, player) then
			return false
		end
	end

	if check.Tool then
		local character2 = localPlayer.Character
		if character2 and not character2:FindFirstChildOfClass("Tool") then
			return false
		end
	end

	if check["Self Knocked"] then
		if CurrentGame.Knocked(localPlayer) then
			return false
		end
	end

	if check.Crew then
		if IsCrew(player) then
			return false
		end
	end

	return true
end

