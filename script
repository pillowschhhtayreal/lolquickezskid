function GetBrandHealthBarAnchor(viewportSize)
	local brandHealthBarObject = BrandHealthBarObject

	if brandHealthBarObject and brandHealthBarObject.Parent and brandHealthBarObject.Visible then
		local absoluteSize = brandHealthBarObject.AbsoluteSize
		local absolutePosition = brandHealthBarObject.AbsolutePosition
		if absoluteSize.X > 40 and absoluteSize.Y > 0 then
			return absolutePosition.X + absoluteSize.X / 2, viewportSize.Y - 100
		end
	end

	local now = Clock()
	if now - BrandHealthBarScanAt < 0.75 then
		return viewportSize.X * 0.625, viewportSize.Y - 100
	end
	BrandHealthBarScanAt = now
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	local max = -MathHuge
	local v = nil

	if playerGui then
		for _, guiObject in next, playerGui:GetDescendants() do
			if not guiObject:IsA("GuiObject") or not guiObject.Visible then
				continue
			end

			local lowerName = string.lower(guiObject.Name)
			local str = ""

			if guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") then
				str = string.lower(guiObject.Text or "")
			end

			if lowerName == "hp" or string.find(lowerName, "health", 1, true) or str == "health" or str == "hp" then
				local absoluteSize = guiObject.AbsoluteSize
				local absolutePosition = guiObject.AbsolutePosition

				if not (absoluteSize.X < 40 or absoluteSize.Y <= 0 or absolutePosition.Y < viewportSize.Y * 0.55) then
					local n = absolutePosition.Y + absoluteSize.X

					if lowerName == "hp" or lowerName == "health" then
						n += 500
					end

					if max < n then
						max = n
						v = guiObject
					end
				end
			end
		end
	end

	BrandHealthBarObject = v
	if v then
		return v.AbsolutePosition.X + v.AbsoluteSize.X / 2, viewportSize.Y - 100
	end
	return viewportSize.X * 0.625, viewportSize.Y - 100
end

