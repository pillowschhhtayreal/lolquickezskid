		end

		if HookedTools[child] then
			return
		end
		HookedTools[child] = true
		local n = 0

		local function fn()
			return fn4(child)
		end

		local isAutoWeapon = AutoWeapons[child.Name] or false
		local isBurstWeapon = BurstWeapons[child.Name] or false

		child.Activated:Connect(function()
			State.IsShooting = true
			local v = fn()

			if isAutoWeapon then
				if Tick() - n < v + 0.0095 then
					return
				end
				n = Tick()
				local flag = true

				Spawn(function()
					while flag and child.Parent == character do
						EmulateGunFire(child)
						Wait(v + 0.0095)
						n = Tick()
					end
				end)

				child.Deactivated:Wait()
				flag = false
				State.IsShooting = false
			elseif isBurstWeapon then
				if getCider().Modifications["Delay Changer"].Enabled then
					if Tick() - n < v + 0.0095 then
						return
					end
					n = Tick()
					local flag = true

					Spawn(function()
						while flag and child.Parent == character do
							EmulateGunFire(child)
							Wait(v + 0.0095)
							n = Tick()
						end
					end)

					child.Deactivated:Wait()
					flag = false
					State.IsShooting = false
				else
					local n2 = 0.3

					Pcall(function()
						local toleranceCooldown = child:FindFirstChild("ToleranceCooldown")

						if toleranceCooldown then
							n2 = toleranceCooldown.Value
						end
					end)

					if Tick() - n < n2 then
						return
					end
					n = Tick()
					local n3 = 3

					Xpcall(function()
						local ammo = child:FindFirstChild("Ammo")

						if ammo then
							n3 = MathMin(n3, ammo.Value)
						end
					end, ErrHandler)

					Spawn(function()
						for i = 1, n3 do
							EmulateGunFire(child)
							Wait(v + 0.0095)
						end
					end)
				end
			else
				if Tick() - n < v + 0.0095 then
					return
				end
				n = Tick()
				EmulateGunFire(child)
				State.IsShooting = false
			end
		end)

		child.Deactivated:Connect(function()
			State.IsShooting = false
		end)
	end)
end

fn8 = function(arg, arg2)
