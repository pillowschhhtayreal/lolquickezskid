function GetStableHealthBarValues(player, humanoid)
	local now = Clock()
	local cachedHealthBarValue = HealthBarValueCache[player]

	if not cachedHealthBarValue or cachedHealthBarValue.Character ~= player.Character then
		cachedHealthBarValue = {
			Character = player.Character,
			Health = tonumber(humanoid.Health) or 0,
			MaxHealth = tonumber(humanoid.MaxHealth) or 100,
			Armor = 0,
			ZeroSince = nil,
			ArmorMissingSince = nil,
		}

		HealthBarValueCache[player] = cachedHealthBarValue
	end

	local maxHealth = tonumber(humanoid.MaxHealth)

	if maxHealth and maxHealth > 0 and maxHealth == maxHealth then
		cachedHealthBarValue.MaxHealth = maxHealth
	end

	local maxHealth2 = cachedHealthBarValue.MaxHealth > 0 and cachedHealthBarValue.MaxHealth or 100
	local num = tonumber(humanoid.Health)
	local flag = humanoid:GetState() == EnumDead or not humanoid.Parent

	if num and num == num and num > 0 then
		cachedHealthBarValue.Health = MathClamp(num, 0, maxHealth2)
		cachedHealthBarValue.ZeroSince = nil
	elseif flag then
		cachedHealthBarValue.Health = 0
		cachedHealthBarValue.ZeroSince = now
	else
		cachedHealthBarValue.ZeroSince = nil
	end

	local healthBarArmor, v = GetHealthBarArmor(player)

	if v then
		cachedHealthBarValue.Armor = MathMax(tonumber(healthBarArmor) or 0, 0)
		cachedHealthBarValue.ArmorMissingSince = nil
	else
		cachedHealthBarValue.ArmorMissingSince = cachedHealthBarValue.ArmorMissingSince or now

		if now - cachedHealthBarValue.ArmorMissingSince >= 0.3 then
			cachedHealthBarValue.Armor = 0
		end
	end

	return cachedHealthBarValue.Health, maxHealth2, cachedHealthBarValue.Armor, flag
end

