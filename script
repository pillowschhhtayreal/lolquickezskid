PositionCache = {}
PositionHistorySize = 8
PositionSampleInterval = 0.03
LastPositionCacheUpdate = 0
PositionEntryPool = {}
PositionPoolSize = 0

function AcquireEntry(position, time)
	local tbl

	if PositionPoolSize > 0 then
		tbl = PositionEntryPool[PositionPoolSize]
		PositionEntryPool[PositionPoolSize] = nil
		PositionPoolSize = PositionPoolSize - 1
		tbl.Position = position
		tbl.Time = time
	else
		tbl = { Position = position, Time = time }
	end

	return tbl
end

function ReleaseEntry(arg)
	PositionPoolSize = PositionPoolSize + 1
	PositionEntryPool[PositionPoolSize] = arg
end

function UpdatePositionCache()
	local now = Clock()
	if now - LastPositionCacheUpdate < PositionSampleInterval then
		return
	end
	LastPositionCacheUpdate = now

	for _, player in next, Players:GetPlayers() do
		if player ~= localPlayer and player.Character then
			local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")

			if humanoidRootPart then
				if not PositionCache[player] then
					PositionCache[player] = {}
				end

				local cachedPositions = PositionCache[player]
				local cachedPosition = cachedPositions[1]

				if not cachedPosition or now - cachedPosition.Time >= PositionSampleInterval then
					table.insert(cachedPositions, 1, AcquireEntry(humanoidRootPart.Position, now))

					if #cachedPositions > PositionHistorySize then
						ReleaseEntry(cachedPositions[#cachedPositions])
						cachedPositions[#cachedPositions] = nil
					end
				end
			end
		end
	end

	for k in next, PositionCache do
		if not k.Parent then
			PositionCache[k] = nil
		end
	end
end

function GetDeltaVelocity(player)
	return (GetSmoothedTargetMotion(player))
end

function GetSmoothedTargetMotion(arg)
	local cachedPositions = PositionCache[arg]
	if not cachedPositions or #cachedPositions < 2 then
		return Vector3Zero, Vector3Zero
	end
	local cachedPosition = cachedPositions[1]
	local cachedPosition2 = cachedPositions[MathMin(#cachedPositions, 4)]
	local n = cachedPosition.Time - cachedPosition2.Time
	if n <= 0.001 then
		return Vector3Zero, Vector3Zero
	end
	local vector = (cachedPosition.Position - cachedPosition2.Position) / n
	local v = Vector3Zero

	if #cachedPositions >= 4 then
		local n2 = cachedPositions[1].Time - cachedPositions[2].Time
		local n3 = cachedPositions[3].Time - cachedPositions[4].Time
		local n4 = (cachedPositions[1].Time + cachedPositions[2].Time - (cachedPositions[3].Time + cachedPositions[4].Time)) * 0.5

		if n2 > 0.001 and n3 > 0.001 and n4 > 0.001 then
			v = ((cachedPositions[1].Position - cachedPositions[2].Position) / n2 - (cachedPositions[3].Position - cachedPositions[4].Position) / n3) / n4
		end
	end

	if vector.Magnitude > 350 then
		vector = Vector3Zero
	end

	if v.Magnitude > 1500 then
		v = Vector3Zero
	end

	return vector, v
end

LureFutureBaselines = { Shotguns = 0.018, Pistols = 0.023, Others = 0.013 }

function UpdateFutureNetwork()
	local future = State.Future
	local now = Clock()
	if now - (future.LastNetworkSample or 0) < 0.1 then
		return
	end
	future.LastNetworkSample = now

	local ok, networkPing = Pcall(function()
		return localPlayer:GetNetworkPing()
	end)

	ok = ok and type(networkPing) == "number" and networkPing >= 0
	local ping = nil

	if ok then
		ping = networkPing > 1 and networkPing / 1000 or networkPing
	end

	if not ping then
		return
	end

	if future.Ping <= 0 then
		future.Ping = ping
		future.Jitter = 0
	else
		future.Jitter += (MathAbs(ping - future.Ping) - future.Jitter) * 0.15
		future.Ping += (ping - future.Ping) * 0.15
	end
end

function GetLureFutureValues(lastTarget, arg, arg2)
	UpdateFutureNetwork()
	local future = State.Future
	local weaponClass = GetWeaponClass(arg or "")

	if future.LastTarget ~= lastTarget or future.LastWeaponClass ~= weaponClass then
		future.LastTarget = lastTarget
		future.LastWeaponClass = weaponClass
		future.CurrentValues = nil
	end

	local values = arg2 and arg2.Values or nil
	local lureFutureBaseline = values and tonumber(values.X) or LureFutureBaselines[weaponClass] or LureFutureBaselines.Others
	local num = values and tonumber(values.Y) or lureFutureBaseline
	local num2 = values and tonumber(values.Z) or lureFutureBaseline
	local n = (future.Ping or 0) * 0.5 + 0.01 + (future.Jitter or 0) * 0.5
	local currentValues = future.CurrentValues
	local currentValues2 = Vector3New(MathClamp(lureFutureBaseline + n, 0.01, 0.2), MathClamp(num + n, 0.01, 0.2), MathClamp(num2 + n, 0.01, 0.2))

	if currentValues then
		currentValues2 = currentValues + (currentValues2 - currentValues) * 0.15
	end

	future.CurrentValues = currentValues2
	local vector, v = GetSmoothedTargetMotion(lastTarget)

	if vector.Magnitude < 2 then
		vector = Vector3Zero
		v = Vector3Zero
	end

	return currentValues2, vector, v
end

