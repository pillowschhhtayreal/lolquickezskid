	local armor2 = leaderstats and (leaderstats:FindFirstChild("Armor") or leaderstats:FindFirstChild("Armour") or leaderstats:FindFirstChild("Defense") or leaderstats:FindFirstChild("Vest"))
	if armor2 and tonumber(armor2.Value) then
